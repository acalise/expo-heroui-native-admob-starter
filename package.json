{
  "name": "expo-heroui-starter",
  "version": "2.0.0",
  "description": "Production-ready Expo SDK 57 starter: HeroUI Native, dark/light theming, onboarding, RevenueCat subscriptions, AppsFlyer attribution, PostHog analytics, and Google AdMob. Every integration is optional and no-ops until you add a key.",
  "author": "acalise",
  "license": "MIT",
  "homepage": "https://github.com/acalise/expo-heroui-native-admob-starter",
  "repository": {
    "type": "git",
    "url": "https://github.com/acalise/expo-heroui-native-admob-starter.git"
  },
  "bugs": {
    "url": "https://github.com/acalise/expo-heroui-native-admob-starter/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "heroui",
    "starter-template",
    "boilerplate",
    "typescript",
    "tailwindcss",
    "dark-mode",
    "revenuecat",
    "appsflyer",
    "posthog",
    "admob",
    "skadnetwork",
    "paywall",
    "onboarding",
    "uniwind"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "check": "npm run type-check && npm run lint",
    "postinstall": "node scripts/patch-expo-swift-interop.js"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.11",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-tracking-transparency": "~57.0.1",
    "heroui-native": "^1.0.8",
    "posthog-react-native": "^4.62.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-appsflyer": "^6.18.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-purchases": "^10.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
